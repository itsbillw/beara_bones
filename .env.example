# Django (dev)
DJANGO_SETTINGS_MODULE=beara_bones.settings_dev
DJANGO_SECRET_KEY=
ALLOWED_HOSTS=localhost
# Production DB (optional for dev)
# DB_NAME= DB_USER= DB_PASSWORD= DB_HOST= DB_PORT=

# Football pipeline (Phase 1–4)
RAPIDAPI_KEY=
# FOOTBALL_INGEST_SOURCE=auto|rapidapi|minio  (auto: RapidAPI if key set, else MinIO raw JSON)
FOOTBALL_INGEST_SOURCE=auto
MINIO_ENDPOINT=minio.itsbillw.eu
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=football
# Processed Parquet lives in the same bucket under the processed/ prefix (football/processed/...).
MINIO_SECURE=true

# Learning vault
MINIO_LEARNING_BUCKET=learning
LEARNING_MAX_UPLOAD_MB=25
LEARNING_INVITE_EXPIRY_DAYS=7

# Optional: Redis for django-rq pipeline jobs and dashboard cache (production Pi)
# REDIS_URL=redis://127.0.0.1:6379/0
